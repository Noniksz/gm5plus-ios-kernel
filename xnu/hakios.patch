+/*
+ * BRINGUP, hs_tick_thread=1: the same poll from a thread of its own, for the case where the
+ * idle loop is not reached while everything is blocked. It yields between polls, so the rest of
+ * the machine still runs; it is off unless asked for, because a spinning thread costs a core.
+ */
+static void
+hakios_tick_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	thread_set_thread_name(current_thread(), "time, polled");
+	for (;;) {
+		hakios_timer_poll();
+		thread_yield_internal(0);       /* no preemption without a timer: hand the cpu over */
+	}
+}
