+/*
+ * BRINGUP: this kernel is told about nothing by the interrupt controller -- see
+ * gic_v3_irq_report(): the firmware leaves every SGI and PPI in the secure group, and a
+ * non-secure write to that bank is dropped by the hardware (measured: an SPI's priority takes,
+ * PPI 27's group and enable do not, and GICD_CTLR.DS is not ours to set). So the virtual timer's
+ * expiry is noticed here, in the idle loop, which already polls the USB controller for the same
+ * reason. Without it the kernel's time never advances: no timeout expires, usleep() never
+ * returns, timer callouts never run.
+ *
+ * It turns itself off the moment a real timer interrupt is taken.
+ */
+int hakios_bringup_log_ready;   /* set once the console is up, see startup.c */
+static int hakios_idle_poll_logged;
+static int hakios_forced_tick_logged;
+uint64_t hakios_forced_ticks;
+uint64_t hakios_idle_poll_calls;
+
+void
+hakios_timer_poll(void)
+{
+#if defined(GENERIC_GIC_V3_IRQ)
+	extern uint64_t gic_vtimer_ticks;
+	uint64_t ctl, freq;
+	cpu_data_t *cdp = getCpuDatap();
+
+	hakios_idle_poll_calls++;
+
+	if (gic_vtimer_ticks != 0) {
+		return;         /* a real interrupt is arriving: nothing to make up for */
+	}
+
+	ctl = __builtin_arm_rsr64("CNTV_CTL_EL0");
+
+	if (hakios_bringup_log_ready && !hakios_idle_poll_logged) {
+		hakios_idle_poll_logged = 1;
+		printf("[TMR] idle poll: reached, CNTV_CTL=0x%lx rtcPop=0x%lx decrementer=0x%lx now=%lu DAIF=0x%lx\n",
+		    (unsigned long)ctl, (unsigned long)cdp->rtcPop,
+		    (unsigned long)cdp->cpu_decrementer, (unsigned long)mach_absolute_time(),
+		    (unsigned long)__builtin_arm_rsr64("DAIF"));
+	}
+
+	if ((ctl & 0x4) == 0) {
+		return;         /* CNTV_CTL.ISTATUS: the timer has not gone off */
+	}
+	if (!ml_get_interrupts_enabled()) {
+		return;         /* the interrupt would have been taken had it been allowed */
+	}
+
+	/* Take this as the interrupt it should have been, with rtclock_intr's contract. */
+	(void)ml_set_interrupts_enabled(FALSE);
+	cdp->cpu_decrementer = -1;      /* Large, as the interrupt path says */
+	rtclock_intr(FALSE);
+
+	/*
+	 * If nothing asked for a new deadline, one is still needed or the timer never fires
+	 * again and no periodic callout (nor a sleeping thread) ever wakes up. One tick a
+	 * millisecond is cheap and leaves any real deadline alone.
+	 */
+	if (__builtin_arm_rsr64("CNTV_CTL_EL0") & 0x4) {
+		freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+		if (freq == 0) {
+			freq = 19200000;
+		}
+		__builtin_arm_wsr64("CNTV_TVAL_EL0", freq / 1000);
+		hakios_forced_ticks++;
+	}
+	(void)ml_set_interrupts_enabled(TRUE);
+
+	if (hakios_bringup_log_ready && !hakios_forced_tick_logged && hakios_forced_ticks != 0) {
+		hakios_forced_tick_logged = 1;
+		printf("[TMR] idle poll: no one re-armed the timer, forcing 1 ms ticks (CNTFRQ=%lu)\n",
+		    (unsigned long)__builtin_arm_rsr64("CNTFRQ_EL0"));
+	}
+#endif
+}
