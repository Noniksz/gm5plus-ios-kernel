+/*
+ * Fast-path ARMv8.3-A PAC instruction emulator for Cortex-A53 (ARMv8.0-A)
+ */
+static boolean_t
+emulate_armv83_pac_on_a53(arm_saved_state_t *state, uint32_t insn)
+{
+	uint64_t pc = get_saved_state_pc(state);
+
+	/* 1. RETAA (0xD65F0BFF) and RETAB (0xD65F0FFF) -> Emulate as RET (X30) */
+	if (insn == 0xD65F0BFFU || insn == 0xD65F0FFFU) {
+		uint64_t lr = get_saved_state_lr(state) & 0x0000FFFFFFFFFFFFULL;
+		set_saved_state_pc(state, lr);
+		return TRUE;
+	}
+
+	/* 2. BRAA / BRAB / BLRAA / BLRAB / BRAAZ / BRABZ / BLRAAZ / BLRABZ
+	 * Encoding:
+	 *   BRAAZ/BRABZ/BLRAAZ/BLRABZ: (insn & 0xFE9FFC1FU) == 0xD61F081FU (Rn in [9:5])
+	 *   BRAA/BRAB/BLRAA/BLRAB:     (insn & 0xFE9FF800U) == 0xD71F0800U (Rn in [9:5], Rm in [4:0])
+	 */
+	if (((insn & 0xFE9FFC1FU) == 0xD61F081FU) ||
+	    ((insn & 0xFE9FF800U) == 0xD71F0800U)) {
+		uint32_t rn = (insn >> 5) & 0x1F;
+		boolean_t is_link = ((insn >> 21) & 0x3) == 1; /* op == 01 is BLR* */
+		uint64_t target = (rn == 31) ? get_saved_state_sp(state) : get_saved_state_reg(state, rn);
+		target &= 0x0000FFFFFFFFFFFFULL; /* Strip upper PAC tag bits */
+		if (is_link) {
+			set_saved_state_lr(state, pc + 4);
+		}
+		set_saved_state_pc(state, target);
+		return TRUE;
+	}
+
+	/* 3. Data-Processing 1-Source PAC/AUT/XPAC instructions:
+	 * PACIA/PACIB/PACDA/PACDB/AUTIA/AUTIB/AUTDA/AUTDB/PACIZA/PACIZB/AUTIZA/AUTIZB/XPACI/XPACD
+	 * Encoding: (insn & 0xFFFF8000U) == 0xDAC10000U
+	 */
+	if ((insn & 0xFFFF8000U) == 0xDAC10000U) {
+		uint32_t rd = insn & 0x1F;
+		if (rd < 31) {
+			uint64_t val = get_saved_state_reg(state, rd) & 0x0000FFFFFFFFFFFFULL;
+			set_saved_state_reg(state, rd, val);
+		}
+		set_saved_state_pc(state, pc + 4);
+		return TRUE;
+	}
+
+	/* 4. PACGA Xd, Xn, Xm: (insn & 0xFFE0FC00U) == 0x9AC03000U */
+	if ((insn & 0xFFE0FC00U) == 0x9AC03000U) {
+		uint32_t rd = insn & 0x1F;
+		if (rd < 31) {
+			set_saved_state_reg(state, rd, 0);
+		}
+		set_saved_state_pc(state, pc + 4);
+		return TRUE;
+	}
+
+	return FALSE;
+}
