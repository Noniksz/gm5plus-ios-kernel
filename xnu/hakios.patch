+	if (kernel_thread_start(hakios_tick_thread, NULL, &thread) == KERN_SUCCESS) {
+		printf("[TMR] polled time: a thread of its own (hs_tick_thread)\n");
+		thread_deallocate(thread);
+	}
+}
